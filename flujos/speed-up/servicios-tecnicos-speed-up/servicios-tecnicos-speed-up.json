    {
      "parameters": {
        "jsCode": "// Recoge el item de entrada\nconst item = $input.item;\n// Obtiene el valor de horas decimales del nodo anterior\nconst decimalHours = $input.first().json.horas; \n\n// Calcula las horas completas (la parte entera)\nconst hours = Math.floor(decimalHours);\n\n// Calcula los minutos\n// 1. Obtiene la parte decimal (ej. 5.75 - 5 = 0.75)\n// 2. Multiplica por 60 para obtener los minutos (ej. 0.75 * 60 = 45)\n// 3. Redondea para evitar decimales extraños por la precisión del punto flotante\nconst minutes = Math.round((decimalHours - hours) * 60);\n\n// Crea el nuevo campo con el formato \"X hrs Y min\"\nitem.json.tiempo_formateado = `${hours} hrs ${minutes} min`;\n\n// Devuelve el item original con el nuevo campo añadido\nreturn item;"
      },

      "parameters": {
        "jsCode": "const dateArgStr = new Date().toLocaleString(\"en-US\", {timeZone: \"America/Argentina/Buenos_Aires\"});\nconst ahora = new Date(dateArgStr);\n//ahora.setHours(0, 0, 0, 0);\n\nconst fechaFin = new Date();\nfechaFin.setDate(ahora.getDate());\nfechaFin.setHours(23, 59, 59, 999);\n\n//QUITAR LUEGO\nconst fechaInicio = new Date();\nfechaInicio.setDate(ahora.getDate());\nfechaInicio.setHours(23, 59, 59, 999);\n\n// Formato Skyia\nconst formatSkyia = (date) => {\n  const d = String(date.getDate()).padStart(2, '0');\n  const m = String(date.getMonth() + 1).padStart(2, '0');\n  const y = date.getFullYear();\n  return `${d}/${m}/${y}`;\n};\n\nreturn [{\n  json: {\n    skyia: {\n      desde: formatSkyia(fechaInicio),\n      hasta: formatSkyia(fechaFin)\n    },\n    ghl: {\n      startTime: fechaInicio.getTime(), // Milisegundos\n      endTime: fechaFin.getTime()   // Milisegundos\n    }\n  }\n}];"
      },

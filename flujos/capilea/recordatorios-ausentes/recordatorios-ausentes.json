    {
      "parameters": {
        "jsCode": "// 1. FECHA EXACTA DE ARGENTINA (A prueba de servidores UTC)\nconst dateArgStr = new Date().toLocaleString(\"en-US\", {timeZone: \"America/Argentina/Buenos_Aires\"});\nconst hoyArg = new Date(dateArgStr);\n\nconst yyyy = hoyArg.getFullYear();\nconst mm = String(hoyArg.getMonth() + 1).padStart(2, '0');\nconst dd = String(hoyArg.getDate()).padStart(2, '0');\n\nconst fechaHoy = `${yyyy}-${mm}-${dd}`; \nconst fechaFormateada = `${dd}/${mm}/${yyyy}`; \n\nconst idToProf = {\n  \"1\": [\"AUSENTES\", \"AUSENTE\"], \n  \"2\": [\"CANCELADOS\", \"CANCELADO\"]\n};\nconst estadosRealizado = [\"REALIZADO\", \"ATENDIDO\"]; \n\nconst palabrasIgnorar = ['MESOTERAPIA', 'MESO', 'PRP', 'PLASMA', 'CONTROL', 'REVISACION', 'REVISACIONES', 'DERMO', 'DERMOPIGMENTACION', 'CAPILAR', 'PO', 'BONIFICADA', 'REFUERZO', 'CORTICOIDES', 'RAMOS', 'MEJIA', 'LOMAS', 'LOMITAS', 'SUCURSAL', 'STREET', 'SAN', 'JUSTO'];\n\n// FUNCIÓN DE COINCIDENCIA DE NOMBRES INFALIBLE POR TOKENS\nfunction verificarCoincidenciaNombre(ghlTitle, skyiaPaciente, minimoPalabras) {\n  if (!ghlTitle || !skyiaPaciente) return false;\n  \n  const cleanWords = (str) => {\n    return str.toUpperCase()\n      .normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\")\n      .replace(/[^A-Z0-9\\s]/g, \" \")\n      .split(/\\s+/)\n      .filter(w => w.length > 1 && !palabrasIgnorar.includes(w));\n  };\n\n  const wordsGHL = cleanWords(ghlTitle);\n  const wordsSkyia = cleanWords(skyiaPaciente);\n\n  let coincidencias = 0;\n  wordsSkyia.forEach(w => {\n    if (wordsGHL.includes(w)) coincidencias++;\n  });\n\n  return coincidencias >= minimoPalabras;\n}\n\n// 2. NODOS GHL Y EXTRACCIÓN HÍBRIDA\nconst nombresNodos = [\n  \"Get Events GHL meso1\", \n  \"Get Events GHL revisaciones1\", \n  \"Get Events GHL dermo1\", \n  \"Get Events GHL prp1\",\n  \"Get Events GHL controles1\"\n];\n\nlet ghlEvents = [];\nlet debugLog = [];\n\nnombresNodos.forEach(nombre => {\n  try {\n    const items = $(nombre).all();\n    items.forEach(item => {\n      if (item.json.events && Array.isArray(item.json.events)) ghlEvents = ghlEvents.concat(item.json.events);\n      else if (item.json.startTime) ghlEvents.push(item.json);\n    });\n  } catch (e) {\n    debugLog.push(`Sin datos en nodo: ${nombre}`);\n  }\n});\n\n// 3. EXTRACCIÓN DE SKYIA (Solo HOY y purgado de ELIMINADOS)\nconst skyiaDetails = $(\"Get_Skyia_Events_Details\").all()\n  .map(i => i.json)\n  .filter(e => e.fecha && e.fecha === fechaHoy && e.estado !== \"ELIMINADO\");\n\n// 4. PROCESAMIENTO Y CRUCE DE DATOS\nconst resultados = [];\nconst vistos = new Set();\n\nghlEvents.forEach(ghlEv => {\n  if (!ghlEv.startTime || !ghlEv.title || !ghlEv.contactId) return;\n\n  const tituloUpper = ghlEv.title.toUpperCase();\n  if (tituloUpper.includes(\"BLOQUEO\") || tituloUpper.includes(\"OCUPADO SKYIA\")) return;\n\n  const [fechaGHL, horaFullGHL] = ghlEv.startTime.split('T');\n  \n  if (fechaGHL === fechaHoy) {\n    const horaGHL = horaFullGHL.substring(0, 5);\n    const key = `${ghlEv.contactId}_${horaGHL}_${ghlEv.calendarId}`; \n\n    if (!vistos.has(key)) {\n      vistos.add(key);\n\n      // NIVEL 1: Coincidencia exacta de hora + 1 palabra del nombre\n      let pacienteSkyia = skyiaDetails.find(sd => {\n        const horaSkyia = sd.horaInicio ? sd.horaInicio.substring(0, 5) : \"\";\n        return horaSkyia === horaGHL && verificarCoincidenciaNombre(tituloUpper, sd.paciente.toUpperCase(), 1);\n      });\n\n      // NIVEL 2: Desfase temporal -> Buscamos en todo el día con un mínimo de 2 palabras coincidentes\n      if (!pacienteSkyia) {\n        pacienteSkyia = skyiaDetails.find(sd => {\n          return verificarCoincidenciaNombre(tituloUpper, sd.paciente.toUpperCase(), 2);\n        });\n      }\n\n      if (pacienteSkyia) {\n        const profUpper = pacienteSkyia.profesional ? pacienteSkyia.profesional.toUpperCase().trim() : \"\";\n        // Aseguramos quitar espacios extra para evaluar el guion correctamente\n        const estadoUpper = pacienteSkyia.estado ? pacienteSkyia.estado.toUpperCase().trim() : \"\"; \n\n        const esAusente = idToProf[\"1\"].includes(profUpper);\n        \n        // 🔥 LÓGICA DE DOCTORES AÑADIDA AQUÍ 🔥\n        // Verificamos si el estado empieza con \"-\" (es un doctor)\n        const esDoctor = estadoUpper.startsWith(\"-\");\n        \n        // Se considera REALIZADO si está en el array de estadosRealizado O si es un Doctor\n        const esRealizado = estadosRealizado.includes(estadoUpper) || esDoctor;\n\n        if (esRealizado || esAusente) {\n          const nombreCompletoRaw = ghlEv.title.split('-')[0].trim();\n          const nombreFormateado = nombreCompletoRaw\n            .split(' ')\n            .filter(word => word.length > 0)\n            .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())\n            .join(' ');\n\n          resultados.push({\n            json: {\n              contactId: ghlEv.contactId,\n              appointmentId: ghlEv.id, \n              nombre: nombreFormateado,\n              hora: horaGHL,\n              fecha: fechaFormateada,\n              especialidad: pacienteSkyia.profesional || \"GENERAL\",\n              // Mantenemos la salida estandarizada para no romper tu nodo Switch posterior\n              estado: esRealizado ? \"REALIZADO\" : \"AUSENTE\", \n              // Dato extra por si deseas usarlo en las automatizaciones\n              doctorAsignado: esDoctor ? pacienteSkyia.estado.trim() : \"N/A\" \n            }\n          });\n        }\n      }\n    }\n  }\n});\n\nif (resultados.length === 0) {\n  return [{ json: { status: \"Sin citas procesadas para hoy\", fechaAuditada: fechaHoy, totalGhlLeidos: ghlEvents.length, errores: debugLog } }];\n}\n\nreturn resultados;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1712,
